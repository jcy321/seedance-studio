  const handleConfirm = async () => {
    if (!selected || !generatingFor) return;
    try {
      await api('/assets/confirm-character', {
        method:'POST',
        body:JSON.stringify({
          original_name: generatingFor.name,
          alias_name: generatingFor.alias,
          prompt_description: generatingFor.description || generatingFor.name,
          image_url: candidates.find(c=>c.id===selected)?.url || '',
