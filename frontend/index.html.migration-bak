// ── AssetWorkflowView ──
function AssetWorkflowView({project, scriptId, onBack, onComplete}) {
  const toast = useToast();
  const [activeTab, setActiveTab] = useState('character');
  const [characters, setCharacters] = useState([]);
  const [scenes, setScenes] = useState([]);
  const [items, setItems] = useState([]);
  const [costumes, setCostumes] = useState([]);
  const [loading, setLoading] = useState(false);
  const [extracting, setExtracting] = useState(false);
  const [extracted, setExtracted] = useState(false);
  const [generatingPromptFor, setGeneratingPromptFor] = useState(null);
  const [generatingImageFor, setGeneratingImageFor] = useState(null);
  const [expandedCard, setExpandedCard] = useState(null);

  useEffect(() => {
    loadAllAssets();
  }, [scriptId]);

  const loadAllAssets = async () => {
    setLoading(true);
    try {
      const [chars, scns, itms, cstms] = await Promise.all([
        api(`/characters/scripts/${scriptId}/list`).catch(() => []),
        api(`/asset-management/scripts/${scriptId}/scenes`).catch(() => []),
        api(`/asset-management/scripts/${scriptId}/items`).catch(() => []),
        api(`/asset-management/scripts/${scriptId}/costumes`).catch(() => [])
      ]);
      console.log('=== Assets loaded ===');
      console.log('Characters:', chars);
      console.log('Scenes:', scns);
      console.log('Items:', itms);
      console.log('Costumes:', cstms);
      setCharacters(chars);
      setScenes(scns);
      setItems(itms);
      setCostumes(cstms);
      setExtracted(chars.length > 0 || scns.length > 0 || itms.length > 0 || cstms.length > 0);
    } catch (e) {
      console.error('Load assets error:', e);
    } finally {
      setLoading(false);
    }
  };

  const handleExtractAssets = async () => {
    setExtracting(true);
    try {
      const result = await api(`/asset-management/scripts/${scriptId}/extract-assets`, {
        method: 'POST'
      });
      toast('资产提取成功', 'success');
      if (result.warnings && result.warnings.length > 0) {
        setTimeout(() => {
          result.warnings.forEach(warning => {
            toast(warning, 'warning');
          });
        }, 500);
      }
      await loadAllAssets();
    } catch (e) {
      console.error('Extract assets error:', e);
      toast(e.message || '提取失败', 'error');
    } finally {
      setExtracting(false);
    }
  };

  const handleGeneratePrompt = async (asset, type) => {
    setGeneratingPromptFor(asset.id);
    try {
      await api('/asset-management/generate-prompt', {
        method: 'POST',
        body: JSON.stringify({
          asset_type: type,
          asset_id: asset.id,
          asset_name: asset.name || asset.original_name,
          asset_description: asset.description || '',
          additional_context: null
        })
      });
      toast('提示词已生成', 'success');
      await loadAllAssets();
    } catch (e) {
      console.error('Generate prompt error:', e);
      toast(e.message || '生成失败', 'error');
    } finally {
      setGeneratingPromptFor(null);
    }
  };

  const handleGenerateImage = async (asset, type) => {
    setGeneratingImageFor(asset.id);
    setExpandedCard(asset.id); // 自动展开卡片
    try {
      if (type === 'character') {
        await api(`/characters/${asset.id}/generate-images`, {
          method: 'POST'
        });
        toast('人设图生成已启动', 'success');
      } else {
        const result = await api('/generation-tasks', {
          method: 'POST',
          body: JSON.stringify({
            task_type: type === 'scene' ? 'scene_image' : type === 'item' ? 'item_image' : 'costume_image',
            prompt: asset.image_prompt || asset.reference_prompt || asset.description,
            metadata: { target_id: asset.id }
          })
        });
        await api(`/generation-tasks/${result.id}/start`, { method: 'POST' });
        toast('图像生成已启动', 'success');
      }
      setTimeout(() => loadAllAssets(), 3000);
    } catch (e) {
      console.error('Generate image error:', e);
      toast(e.message || '生成失败', 'error');
    } finally {
      setGeneratingImageFor(null);
    }
  };

  const handleSelectImage = async (asset, imageIndex, type) => {
    try {
      let endpoint;
      if (type === 'character') {
        endpoint = `/characters/${asset.id}/select-image`;
      } else if (type === 'scene') {
        endpoint = `/asset-management/scenes/${asset.id}/select-image`;
      } else if (type === 'item') {
        endpoint = `/asset-management/items/${asset.id}/select-image`;
      } else if (type === 'costume') {
        endpoint = `/asset-management/costumes/${asset.id}/select-image`;
      }

      if (endpoint) {
        await api(endpoint, {
          method: 'POST',
          body: JSON.stringify({ image_index: imageIndex })
        });
        toast('图像已选择', 'success');
        await loadAllAssets();
      }
    } catch (e) {
      console.error('Select image error:', e);
      toast(e.message || '选择失败', 'error');
    }
  };

  const getAssets = () => {
    if (activeTab === 'character') return characters;
    if (activeTab === 'scene') return scenes;
    if (activeTab === 'item') return items;
    if (activeTab === 'costume') return costumes;
    return [];
  };

  const getStats = (assets) => {
    const total = assets.length;
    const completed = assets.filter(a => a.generation_status === 'completed').length;
    const generating = assets.filter(a => a.generation_status === 'generating').length;
    const failed = assets.filter(a => a.generation_status === 'failed').length;
    return { total, completed, generating, failed };
  };

  const currentAssets = getAssets();
  const stats = getStats(currentAssets);

  return (
    <main style={{padding:'32px 48px',maxWidth:1400,margin:'0 auto'}}>
      {/* 头部 */}
      <div style={{display:'flex',alignItems:'center',justifyContent:'space-between',marginBottom:32}}>
        <div style={{display:'flex',alignItems:'center',gap:16}}>
          <button onClick={onBack} style={{background:'transparent',border:'none',color:T.textMuted,cursor:'pointer',padding:8}}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
          </button>
          <div>
            <h1 style={{fontFamily:T.fontDisplay,fontSize:28,color:T.text,margin:0,fontWeight:700}}>资产管理</h1>
            <p style={{color:T.textMuted,fontSize:14,margin:'4px 0 0'}}>{project.name}</p>
          </div>
        </div>
        <button
          onClick={onComplete}
          style={{background:T.blue,color:'#fff',border:'none',borderRadius:T.radiusMd,padding:'12px 24px',fontSize:14,fontWeight:700,cursor:'pointer'}}>
          进入下一步
        </button>
      </div>

      {/* 提示信息 */}
      {extracted && (
        <div style={{background:T.blueGlow,border:'1px solid '+T.blue,borderRadius:T.radiusMd,padding:'12px 16px',marginBottom:24,display:'flex',alignItems:'center',gap:12}}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke={T.blue} strokeWidth="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 16v-4M12 8h.01"/>
          </svg>
          <span style={{color:T.text,fontSize:14}}>
            请确保角色、场景及道具已全部提取完成，点击角色卡可配置音色，未配置音色将不代表该角色可用。直接跳过该步骤将无法使用资产库中的资产。
          </span>
        </div>
      )}

      {/* 提取资产按钮 */}
      {!extracted && (
        <div style={{textAlign:'center',padding:'60px 20px'}}>
          <div style={{marginBottom:24}}>
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke={T.blue} strokeWidth="1.5" style={{margin:'0 auto'}}>
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
          </div>
          <h3 style={{color:T.text,fontSize:18,fontWeight:600,marginBottom:12}}>提取资产</h3>
          <p style={{color:T.textMuted,fontSize:14,marginBottom:32,lineHeight:1.6}}>
            系统将使用AI从剧本中自动提取角色、场景、道具、服装等资产信息
          </p>
          <button
            onClick={handleExtractAssets}
            disabled={extracting}
            style={{background:extracting?T.surface3:T.blue,color:extracting?T.textDim:'#fff',border:'none',borderRadius:T.radiusMd,padding:'14px 32px',fontSize:14,fontWeight:700,cursor:extracting?'default':'pointer'}}>
            {extracting ? '提取中...' : '开始提取'}
          </button>
        </div>
      )}

      {/* 标签页和内容 */}
      {extracted && (
        <>
          {/* 标签页 */}
          <div style={{display:'flex',gap:24,borderBottom:'2px solid '+T.border,marginBottom:24}}>
            {[
              {key: 'character', label: '角色', count: characters.length},
              {key: 'scene', label: '场景', count: scenes.length},
              {key: 'item', label: '道具', count: items.length},
              {key: 'costume', label: '服装', count: costumes.length}
            ].map(tab => (
              <button
                key={tab.key}
                onClick={() => setActiveTab(tab.key)}
                style={{background:'transparent',border:'none',padding:'12px 0',fontSize:15,fontWeight:600,color:activeTab===tab.key?T.blue:T.textMuted,cursor:'pointer',position:'relative',borderBottom:activeTab===tab.key?'2px solid '+T.blue:'none',marginBottom:-2}}>
                {tab.label}
                <span style={{marginLeft:8,fontSize:12,padding:'2px 8px',borderRadius:999,background:activeTab===tab.key?T.blueGlow:T.surface2,color:activeTab===tab.key?T.blue:T.textDim}}>
                  {tab.count}
                </span>
              </button>
            ))}
          </div>

          {/* 统计信息 */}
          <div style={{display:'flex',gap:16,marginBottom:24}}>
            <div style={{flex:1,padding:16,background:T.surface2,borderRadius:T.radiusMd,border:'1px solid '+T.border}}>
              <div style={{fontSize:24,fontWeight:700,color:T.text,fontFamily:T.fontMono}}>总计 {stats.total}</div>
              <div style={{fontSize:12,color:T.textMuted,marginTop:4}}>已完成 {stats.completed}</div>
            </div>
            <div style={{flex:1,padding:16,background:T.surface2,borderRadius:T.radiusMd,border:'1px solid '+T.border}}>
              <div style={{fontSize:24,fontWeight:700,color:T.blue,fontFamily:T.fontMono}}>生成中 {stats.generating}</div>
              <div style={{fontSize:12,color:T.textMuted,marginTop:4}}>正在处理</div>
            </div>
            <div style={{flex:1,padding:16,background:T.surface2,borderRadius:T.radiusMd,border:'1px solid '+T.border}}>
              <div style={{fontSize:24,fontWeight:700,color:T.red,fontFamily:T.fontMono}}>生成失败 {stats.failed}</div>
              <div style={{fontSize:12,color:T.textMuted,marginTop:4}}>需要重试</div>
            </div>
          </div>

          {/* 资产列表 */}
          {loading ? (
            <div style={{textAlign:'center',padding:'40px 20px'}}>
              <svg width="56" height="56" viewBox="0 0 56 56" fill="none" style={{animation:'spin 1.6s linear infinite',margin:'0 auto 20px'}}>
                <circle cx="28" cy="28" r="24" stroke={T.surface3} strokeWidth="3" fill="none"/>
                <circle cx="28" cy="28" r="24" stroke={T.blue} strokeWidth="3" fill="none" strokeDasharray="150" strokeDashoffset="60" strokeLinecap="round"/>
              </svg>
              <p style={{color:T.textMuted,fontSize:14}}>加载中...</p>
            </div>
          ) : currentAssets.length === 0 ? (
            <div style={{textAlign:'center',padding:'40px 20px'}}>
              <p style={{color:T.textMuted,fontSize:14}}>暂无资产</p>
            </div>
          ) : (
            <div style={{display:'grid',gridTemplateColumns:'repeat(auto-fill, minmax(280px, 1fr))',gap:16}}>
              {currentAssets.map(asset => {
                const isExpanded = expandedCard === asset.id;
                return (
                <div
                  key={asset.id}
                  onClick={() => setExpandedCard(isExpanded ? null : asset.id)}
                  style={{
                    padding:20,
                    background:T.surface2,
                    borderRadius:T.radiusMd,
                    border:'1px solid '+(isExpanded ? T.blue : T.border),
                    cursor:'pointer',
                    transition:'all 0.2s ease',
                    boxShadow: isExpanded ? '0 4px 12px rgba(0,0,0,0.15)' : 'none'
                  }}>
                  {/* 资产名称和状态 */}
                  <div style={{marginBottom:12}}>
                    <h4 style={{color:T.text,fontSize:15,fontWeight:600,margin:'0 0 6px'}}>{asset.name || asset.original_name}</h4>
                    <div style={{display:'flex',alignItems:'center',gap:6}}>
                      {asset.generation_status === 'pending' && (
                        <span style={{fontSize:11,padding:'4px 8px',borderRadius:999,background:T.surface3,color:T.textDim,fontWeight:600}}>待生成</span>
                      )}
                      {asset.generation_status === 'generating' && (
                        <span style={{fontSize:11,padding:'4px 8px',borderRadius:999,background:T.blueGlow,color:T.blue,fontWeight:600}}>生成中</span>
                      )}
                      {asset.generation_status === 'completed' && (
                        <span style={{fontSize:11,padding:'4px 8px',borderRadius:999,background:T.greenGlow,color:T.green,fontWeight:600}}>已完成</span>
                      )}
                      {asset.generation_status === 'failed' && (
                        <span style={{fontSize:11,padding:'4px 8px',borderRadius:999,background:'rgba(248,113,113,0.18)',color:T.red,fontWeight:600}}>失败</span>
                      )}
                    </div>
                  </div>

                  {/* 服装显示所属角色 */}
                  {activeTab === 'costume' && asset.character_name && (
                    <div style={{display:'flex',alignItems:'center',gap:6,marginBottom:8,padding:'6px 10px',background:T.surface3,borderRadius:T.radiusSm}}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={T.purple} strokeWidth="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                      </svg>
                      <span style={{color:T.purple,fontSize:12,fontWeight:600}}>
                        {asset.character_name}
                      </span>
                    </div>
                  )}

                  {/* 描述 */}
                  <p style={{color:T.textMuted,fontSize:13,margin:'0 0 12px',lineHeight:1.5,minHeight:40}}>{asset.description}</p>

                  {/* 提示词 */}
                  {(asset.image_prompt || asset.reference_prompt) && (
                    <div style={{padding:10,background:T.surface3,borderRadius:T.radiusSm,marginBottom:12}}>
                      <div style={{fontSize:11,color:T.textDim,marginBottom:4,fontWeight:600}}>提示词</div>
                      <p style={{color:T.textMuted,fontSize:12,margin:0,fontFamily:T.fontMono,lineHeight:1.4,maxHeight:isExpanded ? 'none' : 60,overflow:isExpanded ? 'visible' : 'hidden',textOverflow:'ellipsis'}}>
                        {asset.image_prompt || asset.reference_prompt}
                      </p>
                    </div>
                  )}

                  {/* 操作按钮 */}
                  <div style={{display:'flex',gap:8}} onClick={(e) => e.stopPropagation()}>
                    {!(asset.image_prompt || asset.reference_prompt) && (
                      <button
                        onClick={() => handleGeneratePrompt(asset, activeTab)}
                        disabled={generatingPromptFor === asset.id}
                        style={{flex:1,background:T.surface3,border:'1px solid '+T.border,borderRadius:T.radiusSm,color:T.text,padding:'8px 12px',fontSize:12,fontWeight:600,cursor:generatingPromptFor===asset.id?'default':'pointer'}}>
                        {generatingPromptFor === asset.id ? '生成中...' : '生成提示词'}
                      </button>
                    )}
                    {(asset.image_prompt || asset.reference_prompt) && asset.generation_status !== 'completed' && (
                      <button
                        onClick={() => handleGenerateImage(asset, activeTab)}
                        disabled={generatingImageFor === asset.id}
                        style={{flex:1,background:generatingImageFor===asset.id?T.surface3:T.blue,color:generatingImageFor===asset.id?T.textDim:'#fff',border:'none',borderRadius:T.radiusSm,padding:'8px 12px',fontSize:12,fontWeight:600,cursor:generatingImageFor===asset.id?'default':'pointer'}}>
                        {generatingImageFor === asset.id ? '生成中...' : '生成图像'}
                      </button>
                    )}
                  </div>

                  {/* 展开内容：生成进度和预览图 */}
                  {isExpanded && (
                    <div style={{marginTop:16,paddingTop:16,borderTop:'1px solid '+T.border}}>
                      {/* 候选图片区域 */}
                      {(asset.generation_status === 'generating' || asset.candidate_images_json) && (
                        <div>
                          <div style={{fontSize:12,color:T.textDim,marginBottom:8,fontWeight:600}}>
                            {asset.generation_status === 'generating' ? '正在生成候选图...' : '候选图片（点击选择）'}
                          </div>
                          <div style={{display:'grid',gridTemplateColumns:'repeat(2, 1fr)',gap:8}}>
                            {/* 生成中：显示4个占位符 */}
                            {asset.generation_status === 'generating' && !asset.candidate_images_json && (
                              <>
                                {[0,1,2,3].map(idx => (
                                  <div
                                    key={idx}
                                    style={{
                                      height:120,
                                      background:T.surface3,
                                      borderRadius:T.radiusSm,
                                      border:'1px solid '+T.border,
                                      display:'flex',
                                      alignItems:'center',
                                      justifyContent:'center'
                                    }}>
                                    <svg width="32" height="32" viewBox="0 0 56 56" fill="none" style={{animation:'spin 1.6s linear infinite'}}>
                                      <circle cx="28" cy="28" r="24" stroke={T.surface3} strokeWidth="3" fill="none"/>
                                      <circle cx="28" cy="28" r="24" stroke={T.blue} strokeWidth="3" fill="none" strokeDasharray="150" strokeDashoffset="60" strokeLinecap="round"/>
                                    </svg>
                                  </div>
                                ))}
                              </>
                            )}

                            {/* 生成完成：显示候选图 */}
                            {asset.candidate_images_json && asset.candidate_images_json.length > 0 && (
                              <>
                                {asset.candidate_images_json.map((imgPath, idx) => (
                                  <div
                                    key={idx}
                                    style={{
                                      position:'relative',
                                      borderRadius:T.radiusSm,
                                      overflow:'hidden',
                                      border: asset.reference_image_path === imgPath ? '2px solid '+T.blue : '1px solid '+T.border,
                                      transition:'all 0.2s ease'
                                    }}>
                                    {/* 缩略图 - 点击放大 */}
                                    <img
                                      src={imgPath}
                                      style={{width:'100%',height:120,objectFit:'cover',display:'block',cursor:'pointer'}}
                                      onClick={(e) => {
                                        e.stopPropagation();
                                        setPreviewImage(imgPath);
                                      }}
                                    />
                                    {/* 选择按钮 */}
                                    <div
                                      onClick={(e) => {
                                        e.stopPropagation();
                                        handleSelectImage(asset, idx, activeTab);
                                      }}
                                      style={{
                                        position:'absolute',
                                        bottom:4,
                                        right:4,
                                        background: asset.reference_image_path === imgPath ? T.blue : 'rgba(0,0,0,0.6)',
                                        color:'#fff',
                                        padding:'4px 8px',
                                        borderRadius:T.radiusSm,
                                        fontSize:11,
                                        fontWeight:600,
                                        cursor:'pointer',
                                        transition:'all 0.2s ease'
                                      }}>
                                      {asset.reference_image_path === imgPath ? '✓ 已选' : '选择'}
                                    </div>
                                  </div>
                                ))}
                              </>
                            )}
                          </div>
                        </div>
                      )}

                      {/* 最终图像 */}
                      {asset.reference_image_path && !asset.candidate_images_json && (
                        <div>
                          <div style={{fontSize:12,color:T.textDim,marginBottom:8,fontWeight:600}}>设定图</div>
                          <img src={asset.reference_image_path} style={{width:'100%',height:200,objectFit:'cover',borderRadius:T.radiusSm}}/>
                        </div>
                      )}
                    </div>
                  )}

                  {/* 缩略图（未展开时显示） */}
                  {!isExpanded && asset.reference_image_path && (
                    <img src={asset.reference_image_path} style={{width:'100%',height:120,objectFit:'cover',borderRadius:T.radiusSm,marginTop:12}}/>
                  )}
                </div>
                );
              })}
            </div>
          )}
        </>
      )}
    </main>
  );
}

// ── AssetManagementPanel ──
function AssetManagementPanel({type, projectId, scriptId, onClose, toast}) {
  const [assets, setAssets] = useState([]);
  const [loading, setLoading] = useState(false);
  const [extracting, setExtracting] = useState(false);
  const [generatingFor, setGeneratingFor] = useState(null);
  const [generationTasks, setGenerationTasks] = useState({});
  const [selectedAssets, setSelectedAssets] = useState(new Set());
  const [sharing, setSharing] = useState(false);
  const [previewImage, setPreviewImage] = useState(null); // 图片预览

  useEffect(() => {
    if (type !== 'extract') {
      loadAssets();
    }
  }, [type]);

  useEffect(() => {
    const onKey = (e) => { if (e.key==='Escape') onClose(); };
    window.addEventListener('keydown', onKey);
    return () => window.removeEventListener('keydown', onKey);
  }, []);

  const loadAssets = async () => {
    setLoading(true);
    try {
      let endpoint = '';
      if (type === 'character') endpoint = `/characters/scripts/${scriptId}/list`;
      else if (type === 'scene') endpoint = `/asset-management/scripts/${scriptId}/scenes`;
      else if (type === 'item') endpoint = `/asset-management/scripts/${scriptId}/items`;
      else if (type === 'costume') endpoint = `/asset-management/scripts/${scriptId}/costumes`;

      console.log('Loading assets from:', endpoint);
      const data = await api(endpoint);
      console.log('Assets loaded:', data);
      setAssets(data);
    } catch (e) {
      console.error('Load assets error:', e);
      toast(e.message || '加载失败', 'error');
    } finally {
      setLoading(false);
    }
  };

  const handleExtractAssets = async () => {
    if (!scriptId) {
      toast('请先上传剧本文档', 'error');
      return;
    }
    setExtracting(true);
    try {
      console.log('Extracting assets for scriptId:', scriptId);
      const result = await api(`/asset-management/scripts/${scriptId}/extract-assets`, {
        method: 'POST'
      });

      // 显示提取结果
      let message = `成功提取 ${result.characters_count||0} 个角色、${result.scenes_count||0} 个场景、${result.items_count||0} 个道具、${result.costumes_count||0} 个服装`;

      // 显示跳过的服装数量
      if (result.skipped_costumes_count > 0) {
        message += `\n跳过 ${result.skipped_costumes_count} 个服装（无法匹配角色）`;
      }

      toast(message, 'success');

      // 显示 warnings
      if (result.warnings && result.warnings.length > 0) {
        setTimeout(() => {
          result.warnings.forEach(warning => {
            toast(warning, 'warning');
          });
        }, 500);
      }

      onClose();
    } catch (e) {
      console.error('Extract assets error:', e);
      toast(e.message || '提取失败', 'error');
    } finally {
      setExtracting(false);
    }
  };

  const handleGeneratePrompt = async (asset) => {
    try {
      console.log('Generating prompt for asset:', asset);
      const result = await api('/asset-management/generate-prompt', {
        method: 'POST',
        body: JSON.stringify({
          asset_type: type,
          asset_id: asset.id,
          asset_name: asset.name || asset.original_name,
          asset_description: asset.description || '',
          additional_context: null
        })
      });
      console.log('Prompt generated:', result);
      toast('提示词已生成', 'success');
      loadAssets();
    } catch (e) {
      console.error('Generate prompt error:', e);
      toast(e.message || '生成失败', 'error');
    }
  };

  const handleGenerateImage = async (asset) => {
    setGeneratingFor(asset.id);
    try {
      console.log('Generating image for asset:', asset, 'type:', type);

      // 角色使用专门的端点
      if (type === 'character') {
        const result = await api(`/characters/${asset.id}/generate-images`, {
          method: 'POST'
        });
        toast('人设图生成成功', 'success');
        loadAssets();
      } else {
        // 其他资产使用生成任务
        const result = await api('/generation-tasks', {
          method: 'POST',
          body: JSON.stringify({
            task_type: type === 'scene' ? 'scene_image' : type === 'item' ? 'item_image' : 'costume_image',
            prompt: asset.image_prompt || asset.reference_prompt || asset.description,
            metadata: { target_id: asset.id }
          })
        });

        const taskId = result.id;
        setGenerationTasks(prev => ({...prev, [asset.id]: taskId}));

        // 启动生成任务
        await api(`/generation-tasks/${taskId}/start`, { method: 'POST' });
        toast('图像生成已启动', 'success');

        // 轮询任务状态
        pollTaskStatus(taskId, asset.id);
      }
    } catch (e) {
      console.error('Generate image error:', e);
      toast(e.message || '生成失败', 'error');
    } finally {
      setGeneratingFor(null);
    }
  };

  const pollTaskStatus = async (taskId, assetId) => {
    const interval = setInterval(async () => {
      try {
        const task = await api(`/generation-tasks/${taskId}`);
        if (task.status === 'completed') {
          clearInterval(interval);
          setGeneratingFor(null);
          toast('图像生成完成', 'success');
          loadAssets();
        } else if (task.status === 'failed') {
          clearInterval(interval);
          setGeneratingFor(null);
          toast('生成失败: ' + (task.error_message || '未知错误'), 'error');
        }
      } catch (e) {
        clearInterval(interval);
        setGeneratingFor(null);
      }
    }, 3000);
  };

  const toggleSelectAsset = (assetId) => {
    const newSelected = new Set(selectedAssets);
    if (newSelected.has(assetId)) {
      newSelected.delete(assetId);
    } else {
      newSelected.add(assetId);
    }
    setSelectedAssets(newSelected);
  };

  const toggleSelectAll = () => {
    if (selectedAssets.size === assets.length) {
      setSelectedAssets(new Set());
    } else {
      setSelectedAssets(new Set(assets.map(a => a.id)));
    }
  };

  const handleShareAssets = async () => {
    if (selectedAssets.size === 0) {
      toast('请先选择要分享的资产', 'warning');
      return;
    }

    setSharing(true);
    try {
      const items = Array.from(selectedAssets).map(id => ({
        asset_type: type,
        source_id: id
      }));

      const result = await api('/asset-management/share', {
        method: 'POST',
        body: JSON.stringify({
          project_id: projectId,
          script_id: scriptId,
          items: items
        })
      });

      toast(`成功分享 ${result.created_assets.length} 个资产，建立 ${result.created_relations.length} 个关系`, 'success');

      // 显示 warnings
      if (result.warnings && result.warnings.length > 0) {
        setTimeout(() => {
          result.warnings.forEach(warning => {
            toast(warning, 'warning');
          });
        }, 500);
      }

      setSelectedAssets(new Set());
      loadAssets();
    } catch (e) {
      console.error('Share assets error:', e);
      toast(e.message || '分享失败', 'error');
    } finally {
      setSharing(false);
    }
  };

  const getTitle = () => {
    if (type === 'extract') return '提取资产';
    if (type === 'character') return '角色管理';
    if (type === 'scene') return '场景管理';
    if (type === 'item') return '道具管理';
    if (type === 'costume') return '服装管理';
    return '资产管理';
  };

  const getColor = () => {
    if (type === 'character') return T.purple;
    if (type === 'scene') return T.green;
    if (type === 'item') return T.accent;
    if (type === 'costume') return T.purple;
    return T.blue;
  };

  const getStatusBadge = (status) => {
    const statusMap = {
      pending: {color: T.textDim, bg: T.surface2, label: '待生成'},
      generating: {color: T.blue, bg: T.blueGlow, label: '生成中'},
      completed: {color: T.green, bg: T.greenGlow, label: '已完成'},
      failed: {color: T.red, bg: 'rgba(248,113,113,0.18)', label: '失败'}
    };
    const s = statusMap[status] || statusMap.pending;
    return (
      <span style={{display:'inline-flex',alignItems:'center',gap:6,fontSize:11,padding:'4px 10px',borderRadius:999,background:s.bg,color:s.color,fontWeight:600}}>
        <span style={{width:6,height:6,borderRadius:'50%',background:s.color,display:'inline-block'}}/>{s.label}
      </span>
    );
  };

  return (
    <div style={{position:'fixed',inset:0,zIndex:1000,display:'flex',alignItems:'center',justifyContent:'center'}} onClick={onClose}>
      <div style={{position:'absolute',inset:0,background:'rgba(0,0,0,0.7)',backdropFilter:'blur(4px)'}}/>
      <div onClick={e=>e.stopPropagation()} style={{position:'relative',width:800,maxHeight:'85vh',overflowY:'auto',background:T.surface1,borderRadius:T.radiusXl,border:'1px solid '+T.border,padding:32,boxShadow:'0 32px 96px rgba(0,0,0,0.6)'}}>
        <div style={{display:'flex',alignItems:'center',justifyContent:'space-between',marginBottom:24}}>
          <div>
            <h2 style={{fontFamily:T.fontDisplay,fontSize:20,color:T.text,margin:0,fontWeight:700}}>{getTitle()}</h2>
            <p style={{color:T.textMuted,fontSize:13,margin:'4px 0 0'}}>
              {type === 'extract' ? '从剧本中提取角色、场景、道具、服装' : `管理${getTitle().replace('管理', '')}资产`}
            </p>
          </div>
          <button onClick={onClose} style={{background:'transparent',border:'none',color:T.textMuted,cursor:'pointer',padding:4}}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
              <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
          </button>
        </div>

        {type === 'extract' ? (
          <div style={{textAlign:'center',padding:'40px 20px'}}>
            <div style={{marginBottom:24}}>
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke={T.blue} strokeWidth="1.5" style={{margin:'0 auto'}}>
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
            </div>
            <h3 style={{color:T.text,fontSize:18,fontWeight:600,marginBottom:12}}>提取资产</h3>
            <p style={{color:T.textMuted,fontSize:14,marginBottom:32,lineHeight:1.6}}>
              系统将使用AI从剧本中自动提取角色、场景、道具、服装等资产信息，<br/>
              并为每个资产生成详细的描述和提示词。
            </p>
            <button
              onClick={handleExtractAssets}
              disabled={extracting}
              style={{background:extracting?T.surface3:T.blue,color:extracting?T.textDim:'#fff',border:'none',borderRadius:T.radiusMd,padding:'14px 32px',fontSize:14,fontWeight:700,cursor:extracting?'default':'pointer',boxShadow:extracting?'none':'0 4px 16px rgba(74,144,226,0.3)'}}>
              {extracting ? (
                <span style={{display:'flex',alignItems:'center',gap:8}}>
                  <svg width="16" height="16" viewBox="0 0 56 56" fill="none" style={{animation:'spin 1.6s linear infinite'}}>
                    <circle cx="28" cy="28" r="24" stroke={T.textDim} strokeWidth="3" fill="none" strokeDasharray="150" strokeDashoffset="60" strokeLinecap="round"/>
                  </svg>
                  提取中...
                </span>
              ) : '开始提取'}
            </button>
          </div>
        ) : loading ? (
          <div style={{textAlign:'center',padding:'40px 20px'}}>
            <svg width="56" height="56" viewBox="0 0 56 56" fill="none" style={{animation:'spin 1.6s linear infinite',transformOrigin:'center',margin:'0 auto 20px'}}>
              <circle cx="28" cy="28" r="24" stroke={T.surface3} strokeWidth="3" fill="none"/>
              <circle cx="28" cy="28" r="24" stroke={getColor()} strokeWidth="3" fill="none" strokeDasharray="150" strokeDashoffset="60" strokeLinecap="round"/>
            </svg>
            <p style={{color:T.textMuted,fontSize:14}}>加载中...</p>
          </div>
        ) : assets.length === 0 ? (
          <div style={{textAlign:'center',padding:'40px 20px'}}>
            <p style={{color:T.textMuted,fontSize:14}}>暂无{getTitle().replace('管理', '')}资产，请先提取资产</p>
          </div>
        ) : (
          <>
            {/* 批量操作工具栏 */}
            <div style={{display:'flex',alignItems:'center',justifyContent:'space-between',marginBottom:16,padding:'12px 16px',background:T.surface2,borderRadius:T.radiusMd,border:'1px solid '+T.border}}>
              <div style={{display:'flex',alignItems:'center',gap:12}}>
                <label style={{display:'flex',alignItems:'center',gap:8,cursor:'pointer'}}>
                  <input
                    type="checkbox"
                    checked={selectedAssets.size === assets.length && assets.length > 0}
                    onChange={toggleSelectAll}
                    style={{width:16,height:16,cursor:'pointer'}}
                  />
                  <span style={{color:T.text,fontSize:13,fontWeight:600}}>
                    全选 ({selectedAssets.size}/{assets.length})
                  </span>
                </label>
              </div>
              {selectedAssets.size > 0 && (
                <button
                  onClick={handleShareAssets}
                  disabled={sharing}
                  style={{background:sharing?T.surface3:T.blue,color:sharing?T.textDim:'#fff',border:'none',borderRadius:T.radiusSm,padding:'8px 16px',fontSize:13,fontWeight:600,cursor:sharing?'default':'pointer',display:'flex',alignItems:'center',gap:6}}>
                  {sharing ? (
                    <>
                      <svg width="14" height="14" viewBox="0 0 56 56" fill="none" style={{animation:'spin 1.6s linear infinite'}}>
                        <circle cx="28" cy="28" r="24" stroke="currentColor" strokeWidth="3" fill="none" strokeDasharray="150" strokeDashoffset="60" strokeLinecap="round"/>
                      </svg>
                      分享中...
                    </>
                  ) : (
                    <>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                        <circle cx="18" cy="5" r="3"/>
                        <circle cx="6" cy="12" r="3"/>
                        <circle cx="18" cy="19" r="3"/>
                        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
                        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
                      </svg>
                      分享选中资产
                    </>
                  )}
                </button>
              )}
            </div>

            {/* 资产列表 */}
            <div style={{display:'flex',flexDirection:'column',gap:12}}>
              {assets.map(asset => (
                <div key={asset.id} style={{padding:'16px 20px',background:T.surface2,borderRadius:T.radiusMd,border:'1px solid '+T.border}}>
                  <div style={{display:'flex',alignItems:'flex-start',gap:12}}>
                    {/* 多选框 */}
                    <input
                      type="checkbox"
                      checked={selectedAssets.has(asset.id)}
                      onChange={() => toggleSelectAsset(asset.id)}
                      style={{width:18,height:18,marginTop:2,cursor:'pointer',flexShrink:0}}
                    />

                    {/* 资产信息 */}
                    <div style={{flex:1}}>
                      <div style={{display:'flex',alignItems:'center',gap:10,marginBottom:6}}>
                        <h4 style={{color:T.text,fontSize:15,fontWeight:600,margin:0}}>{asset.name || asset.original_name}</h4>
                        {getStatusBadge(asset.generation_status)}
                        {asset.user_asset_id && (
                          <span style={{fontSize:11,padding:'4px 8px',borderRadius:999,background:T.greenGlow,color:T.green,fontWeight:600}}>
                            已分享
                          </span>
                        )}
                      </div>

                      {/* 服装显示所属角色 */}
                      {type === 'costume' && asset.character_name && (
                        <div style={{display:'flex',alignItems:'center',gap:6,marginBottom:6}}>
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={T.purple} strokeWidth="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                          </svg>
                          <span style={{color:T.purple,fontSize:12,fontWeight:600}}>
                            属于角色: {asset.character_name}
                          </span>
                        </div>
                      )}

                      <p style={{color:T.textMuted,fontSize:13,margin:0,lineHeight:1.5}}>{asset.description}</p>
                      {(asset.image_prompt || asset.reference_prompt) && (
                        <p style={{color:T.textDim,fontSize:12,margin:'8px 0 0',fontFamily:T.fontMono,lineHeight:1.5}}>
                          提示词: {asset.image_prompt || asset.reference_prompt}
                        </p>
                      )}

                      {/* 操作按钮 */}
                      <div style={{display:'flex',gap:8,marginTop:12}}>
                        {!(asset.image_prompt || asset.reference_prompt) && (
                          <button
                            onClick={() => handleGeneratePrompt(asset)}
                            style={{background:T.surface3,border:'1px solid '+T.border,borderRadius:T.radiusSm,color:T.text,padding:'6px 14px',fontSize:12,fontWeight:600,cursor:'pointer'}}>
                            生成提示词
                          </button>
                        )}
                        {(asset.image_prompt || asset.reference_prompt) && asset.generation_status !== 'completed' && (
                          <button
                            onClick={() => handleGenerateImage(asset)}
                            disabled={generatingFor === asset.id}
                            style={{background:generatingFor===asset.id?T.surface3:getColor(),color:generatingFor===asset.id?T.textDim:'#fff',border:'none',borderRadius:T.radiusSm,padding:'6px 14px',fontSize:12,fontWeight:600,cursor:generatingFor===asset.id?'default':'pointer'}}>
                            {generatingFor === asset.id ? '生成中...' : '生成图像'}
                          </button>
                        )}
                      </div>
                    </div>

                    {/* 缩略图 */}
                    {asset.reference_image_path && (
                      <img src={asset.reference_image_path} style={{width:80,height:80,objectFit:'cover',borderRadius:T.radiusSm,flexShrink:0}}/>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </>
        )}
      </div>

      {/* 图片预览模态框 */}
      {previewImage && (
        <div
          style={{
            position:'fixed',
            inset:0,
            zIndex:2000,
            background:'rgba(0,0,0,0.9)',
            display:'flex',
            alignItems:'center',
            justifyContent:'center',
            padding:20
          }}
          onClick={() => setPreviewImage(null)}>
          <button
            onClick={() => setPreviewImage(null)}
            style={{
              position:'absolute',
              top:20,
              right:20,
              background:'rgba(255,255,255,0.1)',
              border:'1px solid rgba(255,255,255,0.2)',
              color:'#fff',
              width:40,
              height:40,
              borderRadius:'50%',
              cursor:'pointer',
              display:'flex',
              alignItems:'center',
              justifyContent:'center'
            }}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
              <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
          </button>
          <img
            src={previewImage}
            style={{
              maxWidth:'90%',
              maxHeight:'90%',
              objectFit:'contain',
              borderRadius:T.radiusMd,
              boxShadow:'0 32px 96px rgba(0,0,0,0.8)'
            }}
            onClick={(e) => e.stopPropagation()}
          />
        </div>
      )}
    </div>
  );
}

// ── App ──
function App() {
  const [view, setView] = useState(getToken() ? 'workspace' : 'auth');
  const [user, setUser] = useState(getUser());
  const [projectData, setProjectData] = useState(null);
  const [scriptId, setScriptId] = useState(null);
  const [theme, setTheme] = useState(localStorage.getItem('theme') || 'dark');

  useEffect(() => {
    applyTheme(theme);
  }, [theme]);

  const handleThemeToggle = () => {
    const newTheme = theme === 'dark' ? 'light' : 'dark';
    setTheme(newTheme);
    localStorage.setItem('theme', newTheme);
  };

  const handleLogin = () => {
    setUser(getUser());
    setView('workspace');
  };

  const handleLogout = () => {
    clearAuth();
    setUser(null);
    setView('auth');
  };

  const handleOpenProject = (p) => {
    setProjectData(p);
    setView('scriptDetail');
  };

  const handleOpenAssetWorkflow = (project, scriptId) => {
    setProjectData(project);
    setScriptId(scriptId);
    setView('assetWorkflow');
  };

  return (
    <ToastProvider>
      {user ? (
        <div style={{background:T.bg,minHeight:'100vh',color:T.text}}>
          <TopNav view={view} onNavigate={setView} onLogout={handleLogout} theme={theme} onThemeToggle={handleThemeToggle}/>
          <ViewTransition view={view}>
            {view==='workspace' && <WorkspaceView onOpenProject={handleOpenProject}/>}
            {view==='scriptDetail' && <ScriptDetailView project={projectData} onBack={()=>setView('workspace')} onOpenAssetWorkflow={handleOpenAssetWorkflow}/>}
            {view==='assetWorkflow' && <AssetWorkflowView project={projectData} scriptId={scriptId} onBack={()=>setView('scriptDetail')} onComplete={()=>setView('scriptDetail')}/>}
            {view==='assets' && <AssetsView/>}
            {view==='profile' && <ProfileView user={user}/>}
          </ViewTransition>
        </div>
      ) : (
        <AuthView onLogin={handleLogin}/>
      )}
    </ToastProvider>
  );
}

ReactDOM.createRoot(document.getElementById('root')).render(<App/>);
</script>
</body>
</html>
