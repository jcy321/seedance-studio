// ── ProfileView ──
function ProfileView({user}) {
  const toast = useToast();
  const [name, setName] = useState(user?.name||'');
  const [stats, setStats] = useState(null);
  const [settings, setSettings] = useState(null);
  const [showApiKeys, setShowApiKeys] = useState(false);
  const [llmProtocol, setLlmProtocol] = useState('ark');
  const [seedreamProtocol, setSeedreamProtocol] = useState('ark');
  const [seedanceProtocol, setSeedanceProtocol] = useState('ark');
  const [llmUrl, setLlmUrl] = useState('');
  const [llmKey, setLlmKey] = useState('');
  const [llmModelSonnet, setLlmModelSonnet] = useState('');
  const [llmModelHaiku, setLlmModelHaiku] = useState('');
  const [seedreamUrl, setSeedreamUrl] = useState('');
  const [seedreamKey, setSeedreamKey] = useState('');
  const [seedreamModel, setSeedreamModel] = useState('');
  const [seedanceUrl, setSeedanceUrl] = useState('');
  const [seedanceKey, setSeedanceKey] = useState('');
  const [seedanceModel, setSeedanceModel] = useState('');

  // 修改密码相关状态
  const [passwordMode, setPasswordMode] = useState('old'); // 'old' 或 'code'
  const [oldPassword, setOldPassword] = useState('');
  const [newPassword, setNewPassword] = useState('');
  const [confirmPassword, setConfirmPassword] = useState('');
  const [verificationCode, setVerificationCode] = useState('');
  const [codeSending, setCodeSending] = useState(false);
  const [codeCountdown, setCodeCountdown] = useState(0);

  useEffect(() => {
    const load = async () => {
      try {
        const projects = await api('/projects');
        setStats({projectCount: projects.length});
        const userSettings = await api('/user/settings');
        setSettings(userSettings);
        setLlmProtocol(userSettings.llm_api_type || 'ark');
        setLlmUrl(userSettings.llm_base_url || '');
        setLlmModelSonnet(userSettings.llm_model_main || '');
        setLlmModelHaiku(userSettings.llm_model_fast || '');
        setSeedreamProtocol(userSettings.seedream_api_type || 'ark');
        setSeedreamUrl(userSettings.seedream_base_url || '');
        setSeedreamModel(userSettings.seedream_model || '');
        setSeedanceProtocol(userSettings.seedance_api_type || 'ark');
        setSeedanceUrl(userSettings.seedance_base_url || '');
        setSeedanceModel(userSettings.seedance_model || '');
      } catch {}
    };
    load();
  }, []);

  // 验证码倒计时
  useEffect(() => {
    if (codeCountdown > 0) {
      const timer = setTimeout(() => setCodeCountdown(codeCountdown - 1), 1000);
      return () => clearTimeout(timer);
    }
  }, [codeCountdown]);

  const handleSave = () => {
    const u = getUser();
    if (u) { u.name = name; localStorage.setItem('user', JSON.stringify(u)); }
    toast('信息已保存','success');
  };

  const handleSaveSettings = async () => {
    try {
      const payload = {
        llm_api_type: llmProtocol || null,
        llm_base_url: llmUrl || null,
        llm_model_main: llmModelSonnet || null,
        llm_model_fast: llmModelHaiku || null,
        seedream_api_type: seedreamProtocol || null,
        seedream_base_url: seedreamUrl || null,
        seedream_model: seedreamModel || null,
        seedance_api_type: seedanceProtocol || null,
        seedance_base_url: seedanceUrl || null,
        seedance_model: seedanceModel || null,
      };
      if (llmKey.trim()) payload.llm_api_key = llmKey.trim();
      if (seedreamKey.trim()) payload.seedream_api_key = seedreamKey.trim();
      if (seedanceKey.trim()) payload.seedance_api_key = seedanceKey.trim();
      await api('/user/settings', {method:'PUT', body:JSON.stringify(payload)});
      toast('API配置已保存','success');
      setLlmKey('');
      setSeedreamKey('');
      setSeedanceKey('');
      const userSettings = await api('/user/settings');
      setSettings(userSettings);
      setLlmProtocol(userSettings.llm_api_type || 'ark');
      setSeedreamProtocol(userSettings.seedream_api_type || 'ark');
      setSeedanceProtocol(userSettings.seedance_api_type || 'ark');
    } catch (e) {
      toast(e.message,'error');
    }
  };

  const handleSendCode = async () => {
    if (codeSending || codeCountdown > 0) return;
    try {
      setCodeSending(true);
      await api('/auth/send-code', {method:'POST', body:JSON.stringify({email: user.email})});
      toast('验证码已发送到您的邮箱','success');
      setCodeCountdown(60);
    } catch (e) {
      toast(e.message,'error');
    } finally {
      setCodeSending(false);
    }
  };

  const handleChangePassword = async () => {
    if (newPassword.length < 6) {
      toast('新密码长度至少为6个字符','error');
      return;
    }
    if (newPassword !== confirmPassword) {
      toast('两次输入的密码不一致','error');
      return;
    }

    try {
      const payload = {new_password: newPassword};
      if (passwordMode === 'old') {
        if (!oldPassword) {
          toast('请输入旧密码','error');
          return;
        }
        payload.old_password = oldPassword;
