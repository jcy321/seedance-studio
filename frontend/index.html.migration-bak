<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Seedance Studio</title>
<script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
<script src="https://cdn.tailwindcss.com"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&family=Fraunces:wght@600;700&family=JetBrains+Mono:wght@400;600;700&display=swap');
*{margin:0;padding:0;box-sizing:border-box}
body{background:#121212;color:#F0F0F0;font-family:'DM Sans',system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased}
@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes slideInRight{from{transform:translateX(100%)}to{transform:translateX(0)}}
.card-hover{transition:transform .16s cubic-bezier(0.16,1,0.3,1),box-shadow .16s, border-color .16s}
.card-hover:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,0.35);border-color:rgba(255,255,255,0.16)!important}
.card-hover:active{transform:scale(0.98)}
.btn-press{transition:all .12s cubic-bezier(0.16,1,0.3,1)}
.btn-press:hover{transform:scale(1.02)}
.btn-press:active{transform:scale(0.96)}
input:focus,textarea:focus,select:focus{outline:none;border-color:#FF6B00!important}
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:#2E2E2E;border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:#5C5C5C}
</style>
</head>
<body><div id="root"></div>
<script type="text/babel">
const {useState,useEffect,useRef,useCallback,useContext,createContext} = React;

// ── Config ──
const API = `${window.location.origin}/api/v1`;

// Theme definitions
const themes = {
  dark: {
    bg:'#121212', surface1:'#1A1A1A', surface2:'#242424', surface3:'#2E2E2E',
    border:'rgba(255,255,255,0.08)', borderActive:'rgba(255,255,255,0.16)',
    text:'#F0F0F0', textMuted:'#8A8A8A', textDim:'#5C5C5C',
    accent:'#FF6B00', accentHover:'#FF8533', accentGlow:'rgba(255,107,0,0.18)',
    blue:'#4A90E2', blueGlow:'rgba(74,144,226,0.15)',
    green:'#34D399', greenGlow:'rgba(52,211,153,0.15)',
    purple:'#A78BFA', purpleGlow:'rgba(167,139,250,0.15)', red:'#F87171',
  },
  light: {
    bg:'#FFFFFF', surface1:'#F8F9FA', surface2:'#E9ECEF', surface3:'#DEE2E6',
    border:'rgba(0,0,0,0.08)', borderActive:'rgba(0,0,0,0.16)',
    text:'#212529', textMuted:'#6C757D', textDim:'#ADB5BD',
    accent:'#FF6B00', accentHover:'#FF8533', accentGlow:'rgba(255,107,0,0.12)',
    blue:'#0D6EFD', blueGlow:'rgba(13,110,253,0.1)',
    green:'#198754', greenGlow:'rgba(25,135,84,0.1)',
    purple:'#6F42C1', purpleGlow:'rgba(111,66,193,0.1)', red:'#DC3545',
  }
};

let T = {
  ...themes.dark,
  fontDisplay:"'Fraunces','DM Serif Display',serif",
  fontSans:"'DM Sans',system-ui,-apple-system,sans-serif",
  fontMono:"'JetBrains Mono','Fira Code',monospace",
  radiusSm:'6px', radiusMd:'10px', radiusLg:'16px', radiusXl:'24px',
  easeOut:'cubic-bezier(0.16,1,0.3,1)'
};

function applyTheme(themeName) {
  const themeColors = themes[themeName] || themes.dark;
  Object.assign(T, themeColors);
  document.body.style.background = T.bg;
  document.body.style.color = T.text;
}

// ── API Layer ──
async function api(path, opts={}) {
  const token = localStorage.getItem('token');
  const headers = {'Content-Type':'application/json', ...opts.headers};
  if (token) headers['Authorization'] = `Bearer ${token}`;
  const res = await fetch(`${API}${path}`, {...opts, headers});
  if (!res.ok) {
    let msg = '请求失败';
    try { const e = await res.json(); msg = e.detail || msg; } catch {}
    throw new Error(msg);
  }
  return res.status === 204 ? null : res.json();
}

function getToken() { return localStorage.getItem('token'); }
function getUser() {
  try { const u = localStorage.getItem('user'); return u ? JSON.parse(u) : null; } catch { return null; }
}
function saveAuth(token, user) {
  localStorage.setItem('token', token);
  localStorage.setItem('user', JSON.stringify(user));
}
function clearAuth() { localStorage.removeItem('token'); localStorage.removeItem('user'); }

// ── Toast ──
const ToastCtx = createContext(null);
function ToastProvider({children}) {
  const [toasts,setToasts] = useState([]);
  const add = useCallback((msg, kind) => {
    const id = Date.now() + Math.random();
    setToasts(p => [...p, {id, msg, kind: kind||'info'}]);
    setTimeout(() => setToasts(p => p.filter(t => t.id !== id)), 2800);
  }, []);
  return (
    <ToastCtx.Provider value={add}>
      {children}
      <div style={{position:'fixed',bottom:32,right:32,zIndex:9999,display:'flex',flexDirection:'column',gap:10,pointerEvents:'none'}}>
        {toasts.map(t => (
          <div key={t.id} style={{
            background: t.kind==='success' ? T.greenGlow : t.kind==='error' ? 'rgba(248,113,113,0.18)' : T.surface3,
            border:'1px solid '+(t.kind==='success'?T.green:t.kind==='error'?T.red:T.border),
            color:T.text, padding:'10px 18px', borderRadius:T.radiusMd, fontSize:13,
            backdropFilter:'blur(16px)', pointerEvents:'auto',
            boxShadow:'0 8px 32px rgba(0,0,0,0.4)'
          }}>{t.msg}</div>
        ))}
      </div>
    </ToastCtx.Provider>
  );
}
function useToast() { return useContext(ToastCtx) || (()=>{}); }

// ── TopNav ──
function TopNav({view, onNavigate, onLogout, theme, onThemeToggle}) {
  const navItems = [
    {id:'workspace', label:'工作台'},
    {id:'assets', label:'我的资产库'},
    {id:'profile', label:'个人中心'}
  ];
  const [clock, setClock] = useState('');
  useEffect(() => {
    const tick = () => setClock(new Date().toLocaleTimeString('zh-CN',{hour12:false}));
    tick(); const id = setInterval(tick,1000); return () => clearInterval(id);
  }, []);
  return (
    <header style={{height:56,background:T.surface1,borderBottom:'1px solid '+T.border,display:'flex',alignItems:'center',justifyContent:'space-between',padding:'0 24px',position:'sticky',top:0,zIndex:100}}>
      <div style={{display:'flex',alignItems:'center',gap:32}}>
        <div style={{display:'flex',alignItems:'center',gap:10,cursor:'pointer'}} onClick={() => onNavigate('workspace')}>
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
            <circle cx="14" cy="14" r="12" stroke={T.accent} strokeWidth="2" fill="none"/>
            <path d="M10 14 L13 20 L19 9" stroke={T.accent} strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round"/>
          </svg>
          <span style={{fontFamily:T.fontDisplay,fontWeight:700,fontSize:17,color:T.text,letterSpacing:'-0.01em'}}>Seedance</span>
          <span style={{fontSize:11,color:T.textMuted,fontFamily:T.fontMono,background:T.surface2,padding:'2px 6px',borderRadius:4}}>STUDIO</span>
        </div>
        <nav style={{display:'flex',gap:4}}>
          {navItems.map(item => (
            <button key={item.id} onClick={() => onNavigate(item.id)} style={{
              background: view===item.id ? T.surface3 : 'transparent',
              color: view===item.id ? T.text : T.textMuted,
              border:'none', borderRadius:T.radiusMd, padding:'6px 16px', fontSize:13,
              fontWeight: view===item.id ? 600 : 400, cursor:'pointer',
              fontFamily:T.fontSans, transition:'all 160ms '+T.easeOut
            }}>{item.label}</button>
          ))}
        </nav>
      </div>
      <div style={{display:'flex',alignItems:'center',gap:16}}>
        <span style={{fontFamily:T.fontMono,fontSize:12,color:T.textDim,fontFeatureSettings:'"tnum"'}}>{clock}</span>
        <div style={{display:'flex',alignItems:'center',gap:6}}>
          <span style={{width:8,height:8,borderRadius:'50%',background:T.green,boxShadow:'0 0 6px '+T.green,display:'inline-block'}}/>
          <span style={{fontSize:11,color:T.textMuted,letterSpacing:'0.06em'}}>SYSTEM ONLINE</span>
        </div>
        <button onClick={onThemeToggle} title={theme==='dark'?'切换到亮色模式':'切换到暗色模式'} style={{background:'transparent',border:'none',color:T.textMuted,cursor:'pointer',padding:6,display:'flex',alignItems:'center',justifyContent:'center'}}>
          {theme==='dark' ? (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
          ) : (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          )}
        </button>
        <button onClick={onLogout} title="退出登录" style={{background:'transparent',border:'none',color:T.textMuted,cursor:'pointer',padding:6,display:'flex',alignItems:'center',justifyContent:'center'}}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
        </button>
      </div>
    </header>
  );
}

// ── AuthView ──
function AuthView({onLogin}) {
  const toast = useToast();
  const [mode, setMode] = useState('login');
  const [account, setAccount] = useState('admin@seedance.io');
  const [password, setPassword] = useState('admin123456');
  const [regEmail, setRegEmail] = useState('');
  const [regCode, setRegCode] = useState('');
  const [countdown, setCountdown] = useState(0);
  const [codeSent, setCodeSent] = useState(false);
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    if (countdown > 0) { const t = setTimeout(() => setCountdown(c=>c-1), 1000); return () => clearTimeout(t); }
  }, [countdown]);

  const sendCode = async () => {
    if (!regEmail.includes('@')) { toast('请输入有效邮箱地址','error'); return; }
    setCodeSent(true); setCountdown(60);
    try {
      await api('/auth/send-code', {method:'POST', body:JSON.stringify({email:regEmail})});
      toast('验证码已发送至 '+regEmail,'success');
    } catch (e) {
      toast(e.message,'error');
    }
  };

  const handleLogin = async (e) => {
    e.preventDefault();
    if (!account.trim()) { toast('请输入账号','error'); return; }
    if (password.length < 6) { toast('密码至少6位','error'); return; }
    setLoading(true);
    try {
      const data = await api('/auth/login', {method:'POST', body:JSON.stringify({email:account, password})});
      saveAuth(data.access_token, {name:data.nickname||data.email, email:data.email});
      toast('登录成功','success');
      setTimeout(() => onLogin(), 400);
    } catch (e) {
      toast(e.message,'error');
    } finally { setLoading(false); }
  };

  const handleRegister = async (e) => {
    e.preventDefault();
    if (!regEmail.includes('@')) { toast('请输入有效邮箱','error'); return; }
    if (regCode.length < 4) { toast('请输入完整验证码','error'); return; }
    setLoading(true);
    try {
      const data = await api('/auth/register', {
        method:'POST',
        body:JSON.stringify({email:regEmail, password:'test123456', verification_code:regCode, nickname:regEmail.split('@')[0]})
      });
      saveAuth(data.access_token, {name:data.nickname||data.email, email:data.email});
      toast('注册成功','success');
      setTimeout(() => onLogin(), 500);
    } catch (e) {
      toast(e.message,'error');
    } finally { setLoading(false); }
  };

  const isLogin = mode === 'login';
  return (
    <div style={{minHeight:'100vh',display:'flex',alignItems:'center',justifyContent:'center',background:'radial-gradient(ellipse at 50% 50%, '+T.accentGlow+', transparent 70%), '+T.bg}}>
      <div style={{width:420,background:T.surface1,borderRadius:T.radiusXl,border:'1px solid '+T.border,padding:'40px 36px',boxShadow:'0 24px 80px rgba(0,0,0,0.5)'}}>
        <div style={{textAlign:'center',marginBottom:32}}>
          <svg width="40" height="40" viewBox="0 0 28 28" fill="none" style={{marginBottom:16}}>
            <circle cx="14" cy="14" r="12" stroke={T.accent} strokeWidth="2" fill="none"/>
            <path d="M10 14 L13 20 L19 9" stroke={T.accent} strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round"/>
          </svg>
          <h1 style={{fontFamily:T.fontDisplay,fontSize:24,color:T.text,margin:0,fontWeight:700}}>{isLogin?'欢迎回到 Seedance':'创建 Seedance 账号'}</h1>
          <p style={{color:T.textMuted,fontSize:14,marginTop:8}}>{isLogin?'使用邮箱密码登录':'输入邮箱获取验证码完成注册'}</p>
        </div>
        {isLogin ? (
          <form onSubmit={handleLogin}>
            <div style={{marginBottom:14}}>
              <label style={{display:'block',color:T.textMuted,fontSize:12,marginBottom:6,fontWeight:500}}>邮箱</label>
              <input type="email" value={account} onChange={e=>setAccount(e.target.value)}
                placeholder="your@email.com"
                style={{width:'100%',background:T.surface2,border:'1px solid '+T.border,borderRadius:T.radiusMd,padding:'12px 14px',color:T.text,fontSize:14,outline:'none',transition:'border 160ms '+T.easeOut,boxSizing:'border-box'}}/>
            </div>
            <div style={{marginBottom:24}}>
              <label style={{display:'block',color:T.textMuted,fontSize:12,marginBottom:6,fontWeight:500}}>密码</label>
              <input type="password" value={password} onChange={e=>setPassword(e.target.value)} placeholder="输入密码"
                style={{width:'100%',background:T.surface2,border:'1px solid '+T.border,borderRadius:T.radiusMd,padding:'12px 14px',color:T.text,fontSize:14,outline:'none',transition:'border 160ms '+T.easeOut,boxSizing:'border-box'}}/>
            </div>
            <button type="submit" disabled={loading}
              style={{width:'100%',background:T.accent,color:'#fff',border:'none',borderRadius:T.radiusMd,padding:'14px',fontSize:15,fontWeight:700,cursor:loading?'default':'pointer',fontFamily:T.fontSans,boxShadow:'0 4px 20px '+T.accentGlow,opacity:loading?.6:1}}>
              {loading?'登录中...':'登录'}
            </button>
          </form>
        ) : (
          <form onSubmit={handleRegister}>
            <div style={{marginBottom:14}}>
              <label style={{display:'block',color:T.textMuted,fontSize:12,marginBottom:6,fontWeight:500}}>邮箱地址</label>
              <input type="email" value={regEmail} onChange={e=>setRegEmail(e.target.value)} placeholder="name@example.com"
                style={{width:'100%',background:T.surface2,border:'1px solid '+T.border,borderRadius:T.radiusMd,padding:'12px 14px',color:T.text,fontSize:14,outline:'none',transition:'border 160ms '+T.easeOut,boxSizing:'border-box'}}/>
            </div>
            <div style={{marginBottom:24}}>
              <label style={{display:'block',color:T.textMuted,fontSize:12,marginBottom:6,fontWeight:500}}>验证码</label>
              <div style={{display:'flex',gap:10}}>
                <input type="text" value={regCode} onChange={e=>setRegCode(e.target.value)} placeholder="6位验证码" maxLength={6}
                  style={{flex:1,background:T.surface2,border:'1px solid '+T.border,borderRadius:T.radiusMd,padding:'12px 14px',color:T.text,fontSize:14,outline:'none',transition:'border 160ms '+T.easeOut,boxSizing:'border-box'}}/>
                <button type="button" onClick={sendCode} disabled={countdown>0}
                  style={{background:countdown>0?T.surface3:T.accent,color:'#fff',border:'none',borderRadius:T.radiusMd,padding:'12px 18px',fontSize:13,fontWeight:600,cursor:countdown>0?'default':'pointer',whiteSpace:'nowrap',opacity:countdown>0?.6:1}}>
                  {countdown>0 ? countdown+'s' : codeSent ? '重新发送' : '获取验证码'}
                </button>
              </div>
            </div>
            <button type="submit" disabled={loading}
              style={{width:'100%',background:T.accent,color:'#fff',border:'none',borderRadius:T.radiusMd,padding:'14px',fontSize:15,fontWeight:700,cursor:loading?'default':'pointer',boxShadow:'0 4px 20px '+T.accentGlow,opacity:loading?.6:1}}>
              {loading?'注册中...':'注册并登录'}
            </button>
          </form>
        )}
        <p style={{textAlign:'center',marginTop:20,color:T.textMuted,fontSize:13}}>
          {isLogin?'还没有账号？':'已有账号？'}
          <button onClick={()=>{setMode(m=>m==='login'?'register':'login'); setRegCode(''); setCodeSent(false); setCountdown(0);}}
            style={{background:'none',border:'none',color:T.accent,cursor:'pointer',fontSize:13,fontWeight:600}}>{isLogin?'立即注册':'去登录'}
          </button>
        </p>
        <p style={{textAlign:'center',marginTop:12,color:T.textDim,fontSize:11}}>
          开发模式：验证码可直接用 <span style={{fontFamily:T.fontMono,color:T.accent}}>000000</span>
        </p>
      </div>
    </div>
  );
}

// ── ViewTransition ──
function ViewTransition({view, children}) {
  const ref = useRef(null);
  useEffect(() => {
    if (ref.current) {
      ref.current.style.opacity = '0'; ref.current.style.transform = 'translateY(8px)';
      requestAnimationFrame(() => {
        ref.current.style.transition = 'opacity 220ms '+T.easeOut+', transform 220ms '+T.easeOut;
        ref.current.style.opacity = '1'; ref.current.style.transform = 'translateY(0)';
      });
    }
  }, [view]);
  return <div ref={ref} style={{minHeight:'calc(100vh - 56px)'}}>{children}</div>;
}

// ── WorkspaceView ──
function WorkspaceView({onOpenProject}) {
  const toast = useToast();
  const [projects, setProjects] = useState([]);
  const [search, setSearch] = useState('');
  const [filter, setFilter] = useState('all');
  const [loading, setLoading] = useState(true);
  const [showNew, setShowNew] = useState(false);
  const [newTitle, setNewTitle] = useState('');

  const fetchProjects = async () => {
    try {
      const data = await api('/projects');
      setProjects(data);
    } catch (e) { toast(e.message,'error'); }
    finally { setLoading(false); }
  };
  useEffect(() => { fetchProjects(); }, []);

  const handleNew = async () => {
    if (!newTitle.trim()) { toast('请输入剧本名称','error'); return; }
    try {
      const p = await api('/projects', {method:'POST', body:JSON.stringify({title:newTitle.trim()})});
      toast('新剧本已创建','success');
      setShowNew(false); setNewTitle('');
      fetchProjects();
      onOpenProject(p);
    } catch (e) { toast(e.message,'error'); }
  };

  const filtered = projects.filter(p => {
    if (filter !== 'all' && p.status !== filter) return false;
    if (search && !p.title.includes(search)) return false;
    return true;
  });

  const generatingCount = projects.filter(p => p.status==='generating').length;

  return (
    <main style={{padding:'40px 40px 60px',maxWidth:1280,margin:'0 auto'}}>
      <section style={{marginBottom:36}}>
        <div style={{display:'flex',alignItems:'flex-start',justifyContent:'space-between',flexWrap:'wrap',gap:20}}>
          <div>
            <h1 style={{fontFamily:T.fontDisplay,fontSize:30,fontWeight:700,color:T.text,margin:'0 0 6px'}}>我的工作台</h1>
            <p style={{color:T.textMuted,fontSize:14,margin:0}}>共 {projects.length} 个剧本{generatingCount>0?` · ${generatingCount}个正在生成中`:''}</p>
          </div>
          <div style={{display:'flex',gap:10,alignItems:'center',flexWrap:'wrap'}}>
            <div style={{position:'relative'}}>
              <input placeholder="搜索剧本..." value={search} onChange={e=>setSearch(e.target.value)}
                style={{width:200,background:T.surface2,border:'1px solid '+T.border,borderRadius:T.radiusMd,padding:'9px 14px',color:T.text,fontSize:13,outline:'none'}}/>
            </div>
            <select value={filter} onChange={e=>setFilter(e.target.value)}
              style={{background:T.surface2,border:'1px solid '+T.border,borderRadius:T.radiusMd,padding:'9px 12px',color:T.text,fontSize:13,outline:'none',cursor:'pointer'}}>
              <option value="all">全部状态</option>
              <option value="draft">草稿</option>
              <option value="parsing">解析中</option>
              <option value="ready">就绪</option>
              <option value="generating">生成中</option>
              <option value="completed">已完成</option>
            </select>
          </div>
        </div>
      </section>
      <section style={{display:'grid',gridTemplateColumns:'repeat(auto-fill, minmax(300px, 1fr))',gap:20}}>
        <article onClick={()=>setShowNew(true)} className="card-hover" style={{background:T.surface1,borderRadius:T.radiusLg,border:'1px dashed '+T.border,display:'flex',flexDirection:'column',alignItems:'center',justifyContent:'center',minHeight:280,cursor:'pointer'}}>
          <div style={{width:56,height:56,borderRadius:'50%',border:'2px dashed '+T.accent+'44',display:'flex',alignItems:'center',justifyContent:'center',marginBottom:16}}>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke={T.accent} strokeWidth="1.8">
              <path d="M12 5v14M5 12h14"/>
            </svg>
          </div>
          <span style={{fontFamily:T.fontDisplay,fontSize:17,color:T.accent,fontWeight:600}}>新建剧本</span>
          <span style={{fontSize:12,color:T.textDim,marginTop:6}}>上传Word文档开始创作</span>
        </article>
        {loading ? <div style={{gridColumn:'1/-1',textAlign:'center',padding:60,color:T.textMuted}}>加载中...</div> : null}
        {filtered.map(p => <ProjectCard key={p.id} project={p} onClick={onOpenProject}/>)}
        {!loading && filtered.length===0 && (
          <div style={{gridColumn:'1/-1',textAlign:'center',padding:'60px 20px',background:T.surface1,borderRadius:T.radiusLg,border:'1px solid '+T.border}}>
            <p style={{color:T.textMuted,fontSize:15,fontWeight:600}}>没有找到匹配的剧本</p>
            <p style={{color:T.textDim,fontSize:13,marginTop:6}}>尝试调整搜索词或筛选条件</p>
          </div>
        )}
      </section>
      {showNew && (
        <div style={{position:'fixed',inset:0,zIndex:1000,display:'flex',alignItems:'center',justifyContent:'center'}} onClick={()=>{setShowNew(false);setNewTitle('')}}>
          <div style={{position:'absolute',inset:0,background:'rgba(0,0,0,0.7)',backdropFilter:'blur(4px)'}}/>
          <div onClick={e=>e.stopPropagation()} style={{position:'relative',width:440,background:T.surface1,borderRadius:T.radiusXl,border:'1px solid '+T.border,padding:32,boxShadow:'0 32px 96px rgba(0,0,0,0.6)'}}>
            <h2 style={{fontFamily:T.fontDisplay,fontSize:20,color:T.text,margin:'0 0 20px',fontWeight:700}}>新建剧本</h2>
            <input autoFocus value={newTitle} onChange={e=>setNewTitle(e.target.value)} placeholder="输入剧本名称..."
              style={{width:'100%',background:T.surface2,border:'1px solid '+T.border,borderRadius:T.radiusMd,padding:'12px 14px',color:T.text,fontSize:14,outline:'none',boxSizing:'border-box',marginBottom:20}}
              onKeyDown={e=>e.key==='Enter'&&handleNew()}/>
            <div style={{display:'flex',gap:10,justifyContent:'flex-end'}}>
              <button onClick={()=>{setShowNew(false);setNewTitle('')}}
                style={{background:'transparent',border:'1px solid '+T.border,borderRadius:T.radiusMd,color:T.textMuted,padding:'10px 20px',fontSize:13,fontWeight:600,cursor:'pointer'}}>取消</button>
              <button onClick={handleNew}
                style={{background:T.accent,color:'#fff',border:'none',borderRadius:T.radiusMd,padding:'10px 24px',fontSize:13,fontWeight:700,cursor:'pointer',boxShadow:'0 4px 16px '+T.accentGlow}}>创建</button>
            </div>
          </div>
        </div>
      )}
    </main>
  );
}

