function CharacterPanel({characters, projectId, onClose, toast}) {
  const [generatingFor, setGeneratingFor] = useState(null);
  const [candidates, setCandidates] = useState([]);
  const [selected, setSelected] = useState(null);
  const [phase, setPhase] = useState('list');
  const [localChars, setLocalChars] = useState(characters);

  useEffect(() => {
    const loadChars = async () => {
      try {
        const data = await api('/assets?type=character');
        setLocalChars(data.map(a => ({
          id: a.id,
          name: a.original_name,
          alias: a.alias_name,
          status: 'matched',
          thumbnail: a.image_url,
          description: a.prompt_description
        })));
      } catch {}
    };
    if (characters.length === 0) loadChars();
  }, []);

  const handleGenerate = async (char) => {
    setGeneratingFor(char); setPhase('generating'); setSelected(null);
    try {
      const data = await api('/assets/generate-character', {
        method:'POST',
        body:JSON.stringify({description:char.description||char.name, count:4})
      });
      setCandidates(data.images.map((url,i) => ({id:'gen'+i, label:'方案'+String.fromCharCode(65+i), url})));
      setPhase('result');
      toast('4张候选图已生成','success');
    } catch (e) {
      toast(e.message,'error');
      setPhase('list');
